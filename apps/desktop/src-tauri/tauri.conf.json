{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChronoSync",
  "version": "0.0.0",
  "identifier": "dev.chronosync.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "npm run engine:sidecar && npm run dev",
      "cwd": "../.."
    },
    "beforeBuildCommand": {
      "script": "npm run engine:sidecar && npm run build",
      "cwd": "../.."
    },
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ChronoSync",
        "width": 960,
        "height": 680,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'; img-src 'self' data:; script-src 'self'; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["binaries/*"]
  }
}
