{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recorded event v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "run_id",
    "sequence",
    "kind",
    "observed_at",
    "adapter",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "sequence": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "kind": {
      "enum": [
        "execution.state",
        "execution.diagnostic",
        "execution.warning",
        "agent.thread",
        "agent.turn_started",
        "agent.turn_completed",
        "agent.turn_failed",
        "agent.message",
        "agent.reasoning_summary",
        "command.started",
        "command.updated",
        "command.completed",
        "tool.started",
        "tool.updated",
        "tool.completed",
        "file.reported",
        "workspace.changed",
        "adapter.unknown",
        "adapter.warning",
        "adapter.error"
      ]
    },
    "observed_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
    },
    "adapter": {
      "const": "codex"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "message": {
          "type": "string"
        },
        "upstream_type": {
          "type": "string"
        },
        "item_id": {
          "type": "string"
        },
        "thread_id": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "status": {
          "enum": [
            "created",
            "starting",
            "running",
            "completed",
            "failed",
            "cancelled",
            "timed_out",
            "interrupted"
          ]
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "operation"],
            "properties": {
              "path": {
                "type": "string"
              },
              "operation": {
                "type": "string"
              },
              "before": {
                "type": "object",
                "additionalProperties": false,
                "required": ["size", "sha256", "mode"],
                "properties": {
                  "size": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "mode": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "after": {
                "type": "object",
                "additionalProperties": false,
                "required": ["size", "sha256", "mode"],
                "properties": {
                  "size": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "mode": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "truncations": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "original_bytes", "limit_bytes"],
            "properties": {
              "field": {
                "type": "string"
              },
              "original_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "limit_bytes": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  }
}
