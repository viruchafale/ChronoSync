{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChronoSync engine version v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "engine_version", "capabilities"],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "engine_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "version",
          "stdio-recorder-v1",
          "event-v2",
          "timeline-v1",
          "snapshots-v1"
        ]
      }
    }
  }
}
