{
  "name": "chronosync",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "dev": "vite --config apps/desktop/vite.config.ts",
    "build": "tsc --noEmit && vite build --config apps/desktop/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "desktop:dev": "cd apps/desktop && tauri dev",
    "desktop:build": "cd apps/desktop && tauri build --no-bundle",
    "check:docs": "node scripts/check-docs.mjs",
    "test:integration": "node scripts/integration.mjs",
    "engine:sidecar": "node scripts/sidecar.mjs",
    "test:recorder": "node scripts/recorder-integration.mjs",
    "test:live": "node scripts/recorder-integration.mjs --live",
    "desktop:bundle:macos": "cd apps/desktop && tauri build --bundles app --config '{\"bundle\":{\"active\":true}}'",
    "desktop:bundle:dmg": "cd apps/desktop && tauri build --bundles dmg --config '{\"bundle\":{\"active\":true}}'"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ajv": "^8.17.1",
    "eslint": "^10.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
